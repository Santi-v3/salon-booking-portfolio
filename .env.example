# Server
PORT=3456
HOST=127.0.0.1
NODE_ENV=development

# Admin login. Replace every placeholder before starting the application.
ADMIN_USER=admin
ADMIN_PASS=replace-with-a-long-random-password

# Use at least 32 random characters, for example: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional email notifications (Resend). Keep the API key in the environment.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional database path (default: ./data/hairdresser.db)
# DATABASE_PATH=/data/hairdresser.db
